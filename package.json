{
  "name": "quire",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "biome check --formatter-enabled=false .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome ci --formatter-enabled=true --linter-enabled=false --assist-enabled=false .",
    "check:docs": "bun scripts/check-docs.ts",
    "check:budgets": "bun scripts/check-budgets.ts",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run check:docs && bun run check:budgets"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.5",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "linkedom": "^0.18.12",
    "markdownlint": "^0.39.0",
    "mermaid": "^11.12.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.4"
  }
}
